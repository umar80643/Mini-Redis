MINIREDIS_HOST=0.0.0.0
MINIREDIS_PORT=6379
METRICS_PORT=9121
METRICS_ENABLED=true
MAX_CONNECTIONS=1000
CLIENT_IDLE_TIMEOUT=300
MAX_REQUEST_BYTES=1048576
MAX_MEMORY_MB=256
EVICTION_POLICY=allkeys-lru
AOF_ENABLED=true
AOF_PATH=./data/appendonly.aof
AOF_FSYNC=everysec
SNAPSHOT_ENABLED=true
SNAPSHOT_PATH=./data/dump.json
LOG_LEVEL=INFO
MAX_BULK_STRING_BYTES=1048576
MAX_ARRAY_LENGTH=1024
PUBSUB_QUEUE_SIZE=256
SHUTDOWN_TIMEOUT=10

# Replication: leave REPLICA_OF unset to start as a primary. Set it to
# "host:port" to start as a replica following that primary. Role can also
# be changed at runtime via the REPLICAOF command.
# REPLICA_OF=127.0.0.1:6379
REPL_BACKLOG_BYTES=1048576
REPL_ACK_INTERVAL=1.0
REPL_RECONNECT_DELAY=1.0
REPL_READ_TIMEOUT=2.0
REPL_REPLICA_QUEUE_SIZE=1000
